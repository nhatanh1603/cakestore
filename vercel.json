{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "cleanUrls": true,
  "trailingSlash": false,
  "redirects": [
    { "source": "/index.html", "destination": "/", "permanent": true },
    { "source": "/index", "destination": "/", "permanent": true },
    { "source": "/pages/:path*.html", "destination": "/:path*", "permanent": true },
    { "source": "/pages/:path*", "destination": "/:path*", "permanent": true }
  ],
  "rewrites": [
    { "source": "/products", "destination": "/pages/products.html" },
    { "source": "/product-detail", "destination": "/pages/product-detail.html" },
    { "source": "/cart", "destination": "/pages/cart.html" },
    { "source": "/checkout", "destination": "/pages/checkout.html" },
    { "source": "/about", "destination": "/pages/about.html" },
    { "source": "/stores", "destination": "/pages/stores.html" },
    { "source": "/search", "destination": "/pages/search.html" },
    { "source": "/404", "destination": "/404.html" }
  ]
}
